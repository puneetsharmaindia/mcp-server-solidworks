# ---------------------------------------------------------------------------
# Ollama adapter configuration
# Copy this to .env and adjust as needed.
# ---------------------------------------------------------------------------

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Which Ollama model to use. Must support function/tool calling.
# Recommended models (in order of capability):
#   qwen2.5-coder:14b   — excellent structured output, strong function calling
#   llama3.1:8b          — good function calling, lower resource usage
#   llama3.1:70b         — best quality, needs significant GPU RAM
#   mistral:7b           — decent general-purpose, native tool use
#   deepseek-coder-v2    — strong at code and structured JSON
OLLAMA_MODEL=qwen2.5-coder:14b

# Generation temperature (0.0–1.0). Lower = more deterministic.
OLLAMA_TEMPERATURE=0.1

# Context window size (tokens). Increase for complex multi-step builds.
OLLAMA_NUM_CTX=32768

# Path to the MCP server script. Defaults to adapters/claude/server.py.
# MCP_SERVER_SCRIPT=C:\path\to\adapters\claude\server.py

# Python executable for the MCP server subprocess.
# MCP_SERVER_PYTHON=python

# Max consecutive tool-call turns before safety cutoff.
MAX_TOOL_TURNS=30

# Resource pre-loading level: "core", "all", or "none".
#   core — feature-graph schema + recipe index (recommended)
#   all  — core + every recipe section (~40 KB added to system prompt)
#   none — no resources pre-loaded
RESOURCE_PRELOAD=core
